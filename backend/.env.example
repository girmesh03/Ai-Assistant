# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# MongoDB
MONGO_URI=

# Addis AI
ADDIS_AI_BASE_URL=https://api.addisassistant.com
ADDIS_API_KEY=

# Audio processing (used by the STT split/merge pipeline)
FFMPEG_PATH="C:/ffmpeg/ffmpeg"
FFPROBE_PATH="C:/ffmpeg/ffprobe"

# Provider keys — leave blank to hide the provider from /api/meta/models
NVIDIA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=